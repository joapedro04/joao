<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- accessibilityLiveRegion faz o leitor de tela anunciar quando o contador muda. -->
    <TextView
        android:id="@+id/texto_resumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- ChipGroup quebra os chips em várias linhas conforme a largura da tela. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupo_ingredientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
