<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows evita que o conteúdo fique por baixo da barra de status (edge-to-edge). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/texto_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:padding="16dp"
        android:text="@string/titulo_lista"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- A lista ocupa o resto da tela (altura 0dp + peso 1). -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_receitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
