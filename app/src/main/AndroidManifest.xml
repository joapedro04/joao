<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessária para o Coil baixar as fotos das receitas. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trabalhomobil1">

        <!-- Tela inicial do app (aparece no launcher). -->
        <activity
            android:name=".ui.lista.ListaReceitasActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Só é aberta pela própria app (Intent explícita), por isso exported=false. -->
        <activity
            android:name=".ui.detalhe.DetalheReceitaActivity"
            android:exported="false" />
    </application>

</manifest>
